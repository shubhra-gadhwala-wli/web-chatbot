# Copy to backend/.env (gitignored) and fill in. Environment overrides config.yaml.
# Required: 32+ byte random secret used as session/cookie signing material.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
RAG_SESSION_SECRET=

# Optional: credential for the configured OpenAI-compatible generation endpoint.
# Leave empty for a local server that needs no key.
RAG_GENERATION_API_KEY=

# Optional overrides
#RAG_GENERATION_BASE_URL=http://127.0.0.1:11434/v1
#RAG_GENERATION_MODEL=qwen2.5:3b-instruct
#RAG_DATA_DIR=./.local-data
#RAG_HOST=127.0.0.1
#RAG_PORT=8080
# Set to 1 ONLY for offline test runs; skips the pinned-model checksum gate.
#RAG_SKIP_MODEL_CHECK=0
